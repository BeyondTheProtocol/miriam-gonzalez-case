{
  "name": "beyond-the-protocol",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm update-fundraiser && nuxt build",
    "dev": "pnpm update-fundraiser --force && nuxt dev",
    "generate": "pnpm update-fundraiser && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github",
    "doctor": "pnpm dlx vite-doctor@0.0.2 .",
    "icons": "nuxt-seo-utils icons --source favicon.svg",
    "update-fundraiser": "tsx update-fundraiser.ts"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@nuxt/content": "^3.13.0",
    "@nuxtjs/i18n": "^10.3.0",
    "@nuxtjs/plausible": "3.0.2",
    "@nuxtjs/robots": "^6.0.8",
    "@nuxtjs/seo": "5.1.3",
    "@nuxtjs/sitemap": "^8.0.15",
    "@takumi-rs/core": "^1.1.2",
    "@vueuse/nuxt": "14.3.0",
    "better-sqlite3": "^12.9.0",
    "nuxt": "^4.4.4",
    "nuxt-ai-ready": "1.3.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^1.12.0",
    "@nuxtjs/tailwindcss": "^6.13.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^25.9.1",
    "nuxt-seo-utils": "^8.1.11",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@11.5.1"
}
