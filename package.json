{
  "name": "beyond-the-protocol",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm update-fundraiser && nuxt build",
    "dev": "pnpm update-fundraiser --force && nuxt dev",
    "generate": "pnpm update-fundraiser && nuxt generate && tsx scripts/filter-llms-export.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github",
    "test:ciencia-nivel": "node scripts/test-ciencia-nivel.mjs",
    "test:afirmaciones-clinicas": "node scripts/test-afirmaciones-clinicas.mjs",
    "test:citas-futuras": "tsx scripts/test-citas-futuras.ts",
    "test:siglas-muestra": "tsx scripts/test-siglas-muestra.ts",
    "test:mapa-focos": "tsx scripts/test-mapa-focos.ts",
    "test:mallas-3d": "tsx scripts/test-mallas-3d.ts",
    "test:esqueleto-huesos": "tsx scripts/test-esqueleto-huesos.ts",
    "test:que-cambio": "tsx scripts/test-que-cambio.ts",
    "test:short-links": "tsx scripts/test-short-links.ts",
    "icons": "nuxt-seo-utils icons --source favicon.svg",
    "update-fundraiser": "tsx update-fundraiser.ts"
  },
  "dependencies": {
    "@netlify/functions": "^5.3.0",
    "@nuxt/content": "^3.16.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/plausible": "3.0.2",
    "@nuxtjs/robots": "^6.2.3",
    "@nuxtjs/seo": "5.3.16",
    "@nuxtjs/sitemap": "^8.5.1",
    "@takumi-rs/core": "^1.8.7",
    "@types/three": "^0.184.1",
    "@vueuse/nuxt": "14.3.0",
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.5.2",
    "nuxt-ai-ready": "1.3.2",
    "three": "^0.184.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^1.15.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.8",
    "nuxt-seo-utils": "^8.5.1",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0"
  },
  "packageManager": "pnpm@11.5.1"
}
